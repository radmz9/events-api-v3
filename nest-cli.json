{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {"include": "reports/templates/*.hbs", "watchAssets": true},
      {"include": "reports/templates/**/*.hbs", "watchAssets": true},
      {"include": "reports/assets/images/*.png", "watchAssets": true},
      {"include": "reports/assets/images/*.jpg", "watchAssets": true},
      {"include": "reports/assets/fonts/*.ttf", "watchAssets": true}
    ]
  }
}
