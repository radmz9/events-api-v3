<div class="report-footer-block">
    <div class="summary-box">
        <table class="table-summary">
            <p class="section-title">RESUMEN</p>
            <tr>
                <td><strong>EVENTOS</strong></td>
                <td style="text-align: right;">{{total}}</td>
            </tr>

            <tr style="background-color:lightgray; font-weight: bold;">
                <td>HORAS </td>
                <td style="text-align: right;">{{totalHours}}</td>
            </tr>
        </table>
    </div>

    <div class="signature-wrapper">
        <div class="signature-line"></div>
        <p class="signature-label" style="text-transform: uppercase;">{{userRole}}</p>
        <p class="signature-name">{{userName}}</p>
        <p class="signature-label">{{userArea}}</p>
    </div>
</div>
