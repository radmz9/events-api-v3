<style>
    /* Variante Regular */
    @font-face {
        font-family: 'Roboto';
        src: url(data:font/ttf;base64,{{{fonts.regular}}}) format('truetype');
        font-weight: normal;
        font-style: normal;
    }

    .font-regular {
        font-family: 'Roboto', sans-serif;
        font-weight: normal;
        font-style: normal;
    }

    /* Variante Bold */
    @font-face {
        font-family: 'Roboto';
        src: url(data:font/ttf;base64,{{{fonts.bold}}}) format('truetype');
        font-weight: bold;
        font-style: normal;
    }

    .font-bold {
        font-family: 'Roboto', sans-serif;
        font-weight: bold;
        font-style: normal;
    }

    /* Variante Light (300) */
    @font-face {
        font-family: 'Roboto';
        src: url(data:font/ttf;base64,{{{fonts.light}}}) format('truetype');
        font-weight: 300;
        font-style: normal;
    }

    .font-light {
        font-family: 'Roboto', sans-serif;
        font-size: 10px;
        font-weight: 300;
    }

    /* Aplicación global */
    body {
        font-family: 'Roboto', sans-serif;
        font-weight: normal; /* Usa la regular por defecto */
    }

    .logoLeft {
        height: 60px; /* Ajusta el tamaño a tu gusto */
        width: auto;
    }

    .logoRight {
        height: 85px;
        width: auto;
        margin-top: -17px;
    }

    .headerContent {
        display: flex;
        justify-content: space-between;
    }

    .eventInfo {
        font-size: 12px;
        font-weight: bold;
        text-align: center;
    }

    .section-title {
        font-family: 'Roboto', sans-serif;
        background-color: lightgray;
        font-weight: bold;
        text-align: center;
        font-size: 11px;
        page-break-after: avoid;
    }
    table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 20px;
        page-break-inside: auto;
        font-size: 11px;
    }
    tr{
        page-break-inside: avoid;
        page-break-after: auto;
    }
    thead {
        display: table-header-group;
    }
    th {
        font-weight: bold;
        font-size: 11px;
        text-align: left;
    }
    th:nth-child(1), td:nth-child(1) { width: 15%; }
    th:nth-child(2), td:nth-child(2) { width: 45%; }

    .report-footer-block {
        margin-top: 40px;
        page-break-inside: avoid; /* LA CLAVE: No permite romperse entre páginas */
        display: flex;
        flex-direction: column;
        width: 100%;
    }

    .summary-box {
        width: 150px;
        margin-left: auto;
        margin-bottom: 80px; /* Espacio entre el resumen y la firma */
    }
    
    .signature-wrapper {
        width: 300px;
        margin: 0 auto;
        text-align: center;
    }

    .signature-line {
        border-top: 1px solid #000;
        margin-bottom: 8px;
    }

    .signature-name {
        font-weight: bold;
        font-size: 11px;
        margin: 0;
    }

    .signature-label {
        font-size: 11px;
        color: #555;
        margin: 0;
    }
    
    .report-section {
        page-break-inside: avoid;
    }

    .qr-title {
        font-family: 'Roboto' sans-serif;
        font-weight: lighter;
        text-align: center;
    }

    .qr-event-title {
        font-family: 'Roboto', sans-serif;
        font-style: italic;
        text-align: center;
