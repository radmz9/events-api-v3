        width: 40%;
        margin: auto;
        padding: 20px;
        background: #fff;
        border: 6px solid #111;
        border-radius: 10px;
        box-shadow: 4px 4px 0 #111;
    }

    .qr-frame img{
        width: 100%;
        display: block;
    }

    .qr-footer{
        font-family: 'Roboto', sans-serif;
        text-align: center;
        background: #111;
